# DATAcube stack — .env template
# Kopíruj do .env a vyplň secrets
# docker compose automatically picks up .env from this directory

# Admin API key (povinný)
DATACUBE_ADMIN_KEY=dc_admin_6b9e2ae10b062fc6aeb3735f9e2857c6

# Stripe (voliteľné — bez nich webhook vráti 501)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# CORS — domény oddelené čiarkou
DATACUBE_CORS_ORIGINS=https://datacube.marianstancik.dev

# Rate limit
DATACUBE_RATE_LIMIT=100/minute